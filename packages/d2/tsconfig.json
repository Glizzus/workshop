{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",

    // The base denies ambient types, but this package spawns the d2 binary
    // and reads the files it writes, so Node's globals are exactly what it
    // relies on.
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
